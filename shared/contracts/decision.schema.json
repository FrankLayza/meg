{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milestone-escrow-guardian.local/contracts/decision.schema.json",
  "title": "Guardian Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "rationale",
    "confidence",
    "cited_memory_ids",
    "cited_evidence_ids",
    "missing_information"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": ["approve", "request_revision", "escalate"]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "cited_memory_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "cited_evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_information": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
