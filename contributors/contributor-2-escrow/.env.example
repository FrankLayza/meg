# Contributor 2 - escrow release (Base Sepolia)
# Copy to .env and fill in real values. Never commit .env.

# Public Base Sepolia RPC (default used when this is unset)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Always and only a dedicated test wallet funded via a faucet. Never a mainnet key.
GUARDIAN_PRIVATE_KEY=0x...

# Deployed MilestoneEscrow address (set after `npm run escrow:deploy`)
ESCROW_CONTRACT_ADDRESS=0x...

# Comma-separated allowlist of escrow contracts the policy may release FROM
ESCROW_ALLOWLIST=0x...

# Deterministic release cap in wei (default 1_000_000_000_000_000_000)
ESCROW_MAX_AMOUNT_WEI=1000000000000000000