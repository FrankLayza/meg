{
  "name": "milestone-guardian-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/formatters.test.ts src/scenarios.test.ts",
    "demo": "tsx src/cli.ts",
    "demo:walkthrough": "tsx src/cli.ts --walkthrough",
    "demo:revision": "tsx src/cli.ts --scenario revision",
    "demo:approved": "tsx src/cli.ts --scenario approved",
    "demo:escalated": "tsx src/cli.ts --scenario escalated",
    "demo:reset": "tsx src/cli.ts --reset",
    "serve": "tsx src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
